---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getActivePlan } from "@/lib/services/plan";
import PlanGenerator from "@/components/plan/PlanGenerator";
import PlanDisplay from "@/components/plan/PlanDisplay.astro";

const { user } = Astro.locals;
const saved = Astro.url.searchParams.get("saved") === "1";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const activePlan = supabase && user ? await getActivePlan(supabase, user.id) : [];
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen flex-col items-center justify-center gap-6 p-4">
    <div
      class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      {
        saved && (
          <p class="mb-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-300">
            Your training profile was saved.
          </p>
        )
      }
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>

    {
      activePlan.length === 0 ? (
        <PlanGenerator client:load />
      ) : (
        <div class="w-full max-w-2xl">
          <PlanDisplay workouts={activePlan} />
        </div>
      )
    }
  </div>
</Layout>
